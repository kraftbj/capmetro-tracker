# Written by deploy/install.sh, which substitutes the AT-sign tokens below.
#
# Type=oneshot, driven by capmetro-generate.timer. A long-running daemon would
# have to own its own scheduling, its own restart-on-crash and its own log
# rotation; a oneshot that exits gets all three from systemd for free, and a run
# that wedges is killed by the timeout rather than blocking every run after it.
[Unit]
Description=CapMetro dispatch board: poll the realtime feeds and write the API
Documentation=file:///srv/capmetro/src/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@RUN_USER@
Group=@RUN_USER@
ExecStart=@GEN@

# 50 keeps a wedged run from overlapping the next one; the runtime's own flock is
# the backstop if it does.
#
# This does NOT bound the worst case, and the comment that used to say it did was
# wrong. Three feeds at timeout_s each is 45s at the 15 that config.example.php
# ships, which fits -- but timeout_s lives in /etc/capmetro/config.php, which the
# installer never overwrites, so the real figure is whatever that file says.
# On top of it: a cycle where the positions JSON has stalled adds the protobuf
# fallback (capped at 10s), and the upstream feed_version probe adds three ranged
# GETs at timeout_s each -- every 15 minutes after a good probe, but every 3 after
# a failed one, which is precisely when upstream is slow. Worst case is nearer
# 100s than 45s, and has been since long before the fallback existed.
#
# Bounding it means giving the run a deadline rather than each request its own
# timeout; see the TODOS.md entry. Raising this number alone does not change the
# failure mode: the timer fires every 60s, so anything above that guarantees a run
# overruns its own cadence, and a killed run still publishes nothing. A deadline
# lets the run publish what it has.
TimeoutStartSec=50

# The job writes to exactly three places and reads the rest. Everything else on
# the box is off limits: this process talks to the public internet every minute.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=@WEBROOT@ @STATE_DIR@

[Install]
WantedBy=multi-user.target
