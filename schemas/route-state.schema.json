{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capmetro-tracker.local/schemas/route-state.schema.json",
  "title": "GET /api/route/{route_id}.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "route",
    "feeds",
    "staleness",
    "service_day",
    "vehicles",
    "timepoints",
    "schedule",
    "alerts"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/epoch"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "short_name",
        "long_name",
        "directions",
        "next_departure"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "long_name": {
          "type": "string"
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "headsign"
            ],
            "properties": {
              "id": {
                "enum": [
                  0,
                  1
                ]
              },
              "headsign": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "next_departure": {
          "$ref": "common.schema.json#/$defs/nextDeparture"
        }
      }
    },
    "feeds": {
      "$ref": "common.schema.json#/$defs/feeds"
    },
    "staleness": {
      "$ref": "common.schema.json#/$defs/staleness"
    },
    "service_day": {
      "$ref": "common.schema.json#/$defs/serviceDay"
    },
    "vehicles": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/vehicle"
          },
          {
            "description": "A bus in service on a route document always publishes predictions, even when the list is empty. Absent would be indistinguishable from a board built before the field existed.",
            "if": {
              "properties": {
                "in_service": {
                  "const": true
                }
              },
              "required": [
                "in_service"
              ]
            },
            "then": {
              "required": [
                "predictions"
              ]
            }
          }
        ]
      }
    },
    "timepoints": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/timepoint"
      }
    },
    "schedule": {
      "$ref": "common.schema.json#/$defs/schedule"
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/alert"
      }
    }
  }
}
