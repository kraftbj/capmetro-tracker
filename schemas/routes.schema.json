{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capmetro-tracker.local/schemas/routes.schema.json",
  "title": "GET /api/routes.json",
  "description": "The route catalog: one row per generated route file, small enough to fetch on first paint. api-contract.md section 15.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "service_day",
    "routes"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/epoch"
    },
    "service_day": {
      "$ref": "common.schema.json#/$defs/serviceDay",
      "description": "The SYSTEM service day, as in all.json. A route's own answer is has_service_today on its row."
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "short_name",
          "long_name",
          "directions",
          "vehicles",
          "has_service_today"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "short_name": {
            "type": "string"
          },
          "long_name": {
            "type": "string",
            "description": "Verbatim, leading \"{id}-\" and all, exactly as api/route/{id}.json publishes it."
          },
          "directions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "headsign"
              ],
              "properties": {
                "id": {
                  "enum": [
                    0,
                    1
                  ]
                },
                "headsign": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "vehicles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "in_service",
              "out_of_service"
            ],
            "properties": {
              "in_service": {
                "type": "integer",
                "minimum": 0
              },
              "out_of_service": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "has_service_today": {
            "type": "boolean",
            "description": "False when no trip on this route is active for the current service date. The row is published either way."
          }
        }
      }
    }
  }
}
